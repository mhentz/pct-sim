# Macro for general particle source settings

/gps/particle proton
/gps/number 1  # per event

# Energy
/gps/ene/type   Mono
/gps/ene/mono   250 MeV

/gps/ene/type  Gauss
/gps/ene/sigma 0.5 MeV  # 0.2%

# Source
/gps/position  0 0 -325 mm

# Create parallel beam
/gps/pos/type  Plane
/gps/pos/shape Rectangle
/gps/pos/halfx 175 mm
/gps/pos/halfy 1.5 mm

/gps/ang/type beam2d
/gps/ang/rot1 -1 0 0
/gps/ang/sigma_x 0.003 rad
/gps/ang/sigma_y 0.003 rad
